# Copy to .env and fill in. Never commit .env. Never use a work address.
# Mail transport is handled by the `himalaya` CLI (see README); nothing mail-related goes here.

# You, as the target companies know you
AUSKUNFT_FROM_NAME="Vorname Nachname"
AUSKUNFT_FROM_EMAIL="deine.adresse@gmail.com"
AUSKUNFT_POSTAL_ADDRESS="Straße Hausnummer, PLZ Ort"
AUSKUNFT_BIRTHDATE=""                 # optional, TT.MM.JJJJ, only if a target requires it

# himalaya account name from ~/.config/himalaya/config.toml ("" = default account)
AUSKUNFT_HIMALAYA_ACCOUNT=""

# Paths (leave as is)
AUSKUNFT_DATA_DIR="data"
AUSKUNFT_VENDOR_DIR="vendor/datenanfragen"
AUSKUNFT_LLM_KEY=YOUR_KEY